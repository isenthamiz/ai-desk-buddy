# Shared only with the main Buddy backend. Generate a long random value.
NOTES_SERVICE_TOKEN=replace-with-a-random-local-secret

OBSIDIAN_VAULT_PATH=/absolute/path/to/your/Obsidian/Vault
NOTES_OWNER_ID=personal-vault
NOTES_SUPABASE_URL=https://your-project.supabase.co
NOTES_SUPABASE_SECRET_KEY=sb_secret_your-server-side-key

# OpenAI receives note chunks for embedding and selected passages for answers.
OPENAI_API_KEY=your-openai-api-key
NOTES_EMBEDDING_MODEL=text-embedding-3-small
NOTES_CHAT_MODEL=gpt-5-mini
NOTES_EXCLUDE_PATHS=.obsidian,.trash,Private
NOTES_RECONCILE_SECONDS=60
