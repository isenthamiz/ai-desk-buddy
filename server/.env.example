# Copy this file to .env and replace the placeholder with your API key.
OPENAI_API_KEY=your-api-key-here

# Optional: override the cost-sensitive default model.
OPENAI_MODEL=gpt-5.6-luna

# Optional: override the local SQLite reminder database.
BUDDY_DATABASE_PATH=data/buddy.db

# Optional: enable the weather tool for Buddy's fixed location.
BUDDY_WEATHER_LOCATION_NAME=Dublin
BUDDY_WEATHER_LATITUDE=53.3498
BUDDY_WEATHER_LONGITUDE=-6.2603
BUDDY_WEATHER_TIMEZONE=Europe/Dublin

# Optional: enable single-user Todoist task tools.
TODOIST_API_TOKEN=your-personal-api-token
